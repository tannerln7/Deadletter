# Optional. This safe relative example loads committed fictional fixtures.
# Absolute paths and paths relative to the repository root are both supported.
ARCHIVE_DATA_DIR=examples/archive/chains

# Development only. Add reverse-proxy hostnames as a comma-separated list.
# Use hostnames without a URL scheme or port.
ARCHIVE_ALLOWED_DEV_ORIGINS=deadletter.example.test

# Canonical origins used for host isolation and absolute share URLs.
ARCHIVE_PRIVATE_ORIGIN=https://archive.example.test
ARCHIVE_SHARE_ORIGIN=https://share.example.test

# Cloudflare Access application verification. Use the team hostname shown by Access.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace-with-access-application-audience

# Comma-separated verified Access `sub` values allowed to manage public links.
ARCHIVE_SHARE_MANAGER_SUBS=replace-with-verified-access-sub

# Production uses a service-owned path such as /var/lib/deadletter/shares.sqlite.
ARCHIVE_SHARE_DB=/var/lib/deadletter/shares.sqlite
